rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Connection health check
    match /_connection_test/{docId} {
      allow read, write: if true;
    }

    // Enrollments: Clients can submit registration, verify token, and authenticate
    match /enrollments/{enrollmentId} {
      allow create: if isValidId(enrollmentId);
      allow get, list: if true;
      allow update: if isValidId(enrollmentId);
      allow delete: if false;
    }

    // Users & Students profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    match /students/{studentId} {
      allow read, write: if true;
    }

    match /password_resets/{resetId} {
      allow read, write: if true;
    }

    // Verification emails log
    match /verification_emails/{emailId} {
      allow create: if isValidId(emailId);
      allow get, list: if true;
      allow update, delete: if false;
    }

    // Trigger email queue for external delivery extensions
    match /mail/{mailId} {
      allow create: if isValidId(mailId);
      allow get, list: if true;
      allow update, delete: if false;
    }
  }
}
