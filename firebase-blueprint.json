{
  "entities": {
    "enrollment": {
      "title": "Enrollment",
      "description": "Client enrollment registration details and email verification status",
      "type": "object",
      "properties": {
        "student_id": {
          "type": "string",
          "description": "Student unique identifier or email"
        },
        "payment_id": {
          "type": "string",
          "description": "Associated payment transaction identifier"
        },
        "enrolled_at": {
          "type": "string",
          "description": "ISO timestamp of course enrollment"
        },
        "fullName": {
          "type": "string",
          "description": "Full name of student"
        },
        "phoneNumber": {
          "type": "string",
          "description": "Phone number with country code"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Student email address"
        },
        "whatsappReceipts": {
          "type": "boolean",
          "description": "Consent for WhatsApp receipts and updates"
        },
        "courseId": {
          "type": "string",
          "description": "Enrolled course identifier"
        },
        "courseTitle": {
          "type": "string",
          "description": "Title of the course"
        },
        "amount": {
          "type": "number",
          "description": "Course price in USD"
        },
        "currency": {
          "type": "string",
          "description": "Payment currency, e.g. USD"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "active", "suspended", "completed", "pending_verification", "verified", "enrolled", "pending_payment_verification"],
          "description": "Current enrollment and verification status"
        },
        "orderReference": {
          "type": "string",
          "description": "Auto-incrementing order reference, e.g. LA-2026-0001"
        },
        "manualCurrency": {
          "type": "string",
          "enum": ["EVC Plus", "eDahab", "ZAAD"],
          "description": "Manual mobile money provider"
        },
        "recipientNumber": {
          "type": "string",
          "description": "Merchant phone number, e.g. +252 61 9290900"
        },
        "recipientName": {
          "type": "string",
          "description": "Merchant recipient name, e.g. Abdifatah Jama"
        },
        "transactionRef": {
          "type": "string",
          "description": "Payment reference code or SMS ID"
        },
        "amountPaid": {
          "type": "number",
          "description": "Amount paid by student"
        },
        "paymentDate": {
          "type": "string",
          "description": "Date payment was completed"
        },
        "senderPhone": {
          "type": "string",
          "description": "Student sending phone number"
        },
        "screenshotUrl": {
          "type": "string",
          "description": "Optional payment screenshot data"
        },
        "verificationToken": {
          "type": "string",
          "description": "Unique cryptographic email verification token"
        },
        "emailVerified": {
          "type": "boolean",
          "description": "Whether the client email has been verified"
        },
        "passwordHash": {
          "type": "string",
          "description": "Cryptographic salted hash of student password"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of registration"
        }
      },
      "required": ["fullName", "email", "courseId"]
    },
    "verificationEmail": {
      "title": "VerificationEmail",
      "description": "Dispatched verification email record",
      "type": "object",
      "properties": {
        "to": {
          "type": "string",
          "format": "email",
          "description": "Recipient email"
        },
        "recipientName": {
          "type": "string",
          "description": "Recipient full name"
        },
        "subject": {
          "type": "string",
          "description": "Subject of verification email"
        },
        "token": {
          "type": "string",
          "description": "Verification security token"
        },
        "sentAt": {
          "type": "string",
          "description": "Timestamp when email was sent"
        },
        "status": {
          "type": "string",
          "enum": ["sent", "verified", "expired"],
          "description": "Status of the email"
        }
      },
      "required": ["to", "token"]
    },
    "user": {
      "title": "User",
      "description": "Registered and verified student user profile and account details",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Student unique identifier"
        },
        "fullName": {
          "type": "string",
          "description": "Full name of the student"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Student email address"
        },
        "phoneNumber": {
          "type": "string",
          "description": "Student phone number"
        },
        "country": {
          "type": "string",
          "description": "Country of origin"
        },
        "emailVerified": {
          "type": "boolean",
          "description": "Verification status"
        },
        "passwordHash": {
          "type": "string",
          "description": "Cryptographic salted hash of student password"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO creation timestamp"
        }
      },
      "required": ["fullName", "email"]
    },
    "passwordReset": {
      "title": "PasswordReset",
      "description": "Password reset token and verification code record",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Student email"
        },
        "code": {
          "type": "string",
          "description": "6-digit numeric verification code"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp"
        },
        "expiresAt": {
          "type": "string",
          "description": "ISO expiration timestamp"
        },
        "status": {
          "type": "string",
          "enum": ["active", "used", "expired"],
          "description": "Status"
        }
      },
      "required": ["email", "code"]
    },
    "payment": {
      "title": "Payment",
      "description": "Student payment transactions submitted for manual or automated verification",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Payment ID" },
        "order_id": { "type": "string", "description": "Associated order ID" },
        "student_id": { "type": "string", "description": "Student user ID or email" },
        "student_name": { "type": "string", "description": "Full name of student" },
        "student_email": { "type": "string", "description": "Email address of student" },
        "course_id": { "type": "string", "description": "Enrolled course identifier" },
        "course_title": { "type": "string", "description": "Title of course" },
        "amount": { "type": "number", "description": "Payment amount in USD" },
        "currency": { "type": "string", "description": "Currency code" },
        "payment_method": { "type": "string", "description": "Payment method, e.g. EVC Plus, eDahab, ZAAD" },
        "transaction_reference": { "type": "string", "description": "Transaction reference code" },
        "sender_phone": { "type": "string", "description": "Sender mobile phone number" },
        "proof_url": { "type": "string", "description": "URL or base64 preview of payment receipt screenshot" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "paid"], "description": "Verification status" },
        "submitted_at": { "type": "string", "description": "Submission ISO timestamp" },
        "verified_at": { "type": "string", "description": "Verification ISO timestamp" },
        "verified_by": { "type": "string", "description": "Admin email who verified" }
      },
      "required": ["order_id", "student_id", "course_id", "amount", "payment_method", "transaction_reference", "status"]
    },
    "order": {
      "title": "Order",
      "description": "Student purchase orders for course enrollments",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Order ID" },
        "student_id": { "type": "string", "description": "Student ID or email" },
        "student_name": { "type": "string", "description": "Student name" },
        "course_id": { "type": "string", "description": "Course identifier" },
        "course_title": { "type": "string", "description": "Course title" },
        "amount": { "type": "number", "description": "Order amount" },
        "currency": { "type": "string", "description": "Currency code" },
        "status": { "type": "string", "enum": ["pending", "awaiting_verification", "paid", "rejected", "cancelled", "completed"], "description": "Order status" },
        "created_at": { "type": "string", "description": "Creation timestamp" },
        "paid_at": { "type": "string", "description": "Payment approval timestamp" }
      },
      "required": ["student_id", "course_id", "amount", "status"]
    },
    "course": {
      "title": "Course",
      "description": "Academy course offerings and technical curriculum",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique course identifier" },
        "title": { "type": "string", "description": "Course title" },
        "subtitle": { "type": "string", "description": "Course subtitle" },
        "description": { "type": "string", "description": "Full description of course" },
        "category": { "type": "string", "description": "Subject category" },
        "level": { "type": "string", "enum": ["Beginner", "Intermediate", "Advanced"], "description": "Course difficulty level" },
        "price": { "type": "number", "description": "Current price in USD" },
        "originalPrice": { "type": "number", "description": "Original price before discount" },
        "discountPercent": { "type": "number", "description": "Discount percentage" },
        "estimatedHours": { "type": "number", "description": "Estimated completion hours" },
        "totalLessonsCount": { "type": "number", "description": "Total lesson count" },
        "thumbnail": { "type": "string", "description": "Course thumbnail image URL" },
        "tags": { "type": "array", "items": { "type": "string" }, "description": "Course tags" },
        "updatedAt": { "type": "string", "description": "Last updated date" }
      },
      "required": ["id", "title", "description", "category", "level", "price"]
    }
  },
  "firestore": {
    "/courses/{courseId}": {
      "schema": "course",
      "description": "Lafole Academy courses available in catalog"
    },
    "/enrollments/{enrollmentId}": {
      "schema": "enrollment",
      "description": "Student enrollments and details created upon checkout"
    },
    "/payments/{paymentId}": {
      "schema": "payment",
      "description": "Manual mobile payment records for admin verification"
    },
    "/orders/{orderId}": {
      "schema": "order",
      "description": "Course purchase orders for students"
    },
    "/users/{userId}": {
      "schema": "user",
      "description": "Student profiles and account credentials"
    },
    "/students/{studentId}": {
      "schema": "user",
      "description": "Student records mirrored for directory visibility"
    },
    "/password_resets/{resetId}": {
      "schema": "passwordReset",
      "description": "Student password reset codes and tokens"
    },
    "/verification_emails/{emailId}": {
      "schema": "verificationEmail",
      "description": "Records of verification emails dispatched to students"
    }
  }
}
